{
    "name": "fullstack/php-api",
    "type": "project",
    "description": "PHP API with REST + GraphQL supporting PostgreSQL and MySQL",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php artisan serve --port=8081"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    }
}